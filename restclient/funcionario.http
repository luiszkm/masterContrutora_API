### @name BuscarFuncionarios
# 4.1. Busca todos os funcionários cadastrados (sem paginação).
GET {{hostname}}/funcionarios
Cookie: jwt-token={{token}}

### @name BuscarFuncionariosPaginado
# 4.1.1. Lista funcionários com paginação - Primeira página
GET {{hostname}}/funcionarios?pagina=1&tamanhoPagina=5
Cookie: jwt-token={{token}}

### @name BuscarFuncionariosSegundaPagina
# 4.1.2. Lista funcionários com paginação - Segunda página
GET {{hostname}}/funcionarios?pagina=2&tamanhoPagina=5
Cookie: jwt-token={{token}}

### @name BuscarFuncionariosFiltradosPorStatus
# 4.1.3. Lista funcionários filtrados por status com paginação
GET {{hostname}}/funcionarios?pagina=1&tamanhoPagina=10&status=Ativo
Cookie: jwt-token={{token}}

# ===================================================================
### 4.2 Buscar Funcionário Específico
GET {{hostname}}/funcionarios/{{funcionarioId}}
Cookie: jwt-token={{token}}

# ===================================================================
## 4.3 Deletar Funcionário  
### @name DeletarFuncionario

DELETE {{hostname}}/funcionarios/{{funcionarioId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

# ===================================================================
## 4.3 Deletar Funcionário  
### @name AtivarFuncionario

PATCH  {{hostname}}/funcionarios/{{funcionarioId}}/ativar
Content-Type: application/json
Cookie: jwt-token={{token}}

