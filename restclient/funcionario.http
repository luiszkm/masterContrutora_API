### @name CriarApontamentoSemObra
# Teste: Criar apontamento sem informar obraId (deve funcionar)
POST {{hostname}}/apontamentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "funcionarioId": "{{funcionarioId}}",
    "periodoInicio": "2025-12-01",
    "periodoFim": "2025-12-15",
    "diaria": 300.00,
    "diasTrabalhados": 10
}

### @name CriarApontamentoComObraVazia
# Teste: Criar apontamento com obraId como string vazia
POST {{hostname}}/apontamentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "funcionarioId": "{{funcionarioId}}",
    "obraId": "",
    "periodoInicio": "2025-12-16",
    "periodoFim": "2025-12-31",
    "diaria": 300.00,
    "diasTrabalhados": 10
}

