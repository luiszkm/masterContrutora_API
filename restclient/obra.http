# ===================================================================
# [FLUXO 2] - CENÁRIO DE UMA OBRA COMPLETA
# ===================================================================

###
# @name CriarObraPrincipal
# 7. Cria a obra principal para os testes.
POST {{hostname}}/obras
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Obra teste de sync",
    "cliente": "ncorporadora Morar Bem",
    "endereco": "Rua das Palmeiras, 100",
    "dataInicio": "2025-08-01",
    "DataFim": "2025-12-31",
    "descricao": "Obra de teste para o fluxo completo"
}

> {%
    client.global.set("obraId", response.body.ID);
%}

###
# @name AdicionarEtapaPrincipal
# 8. Adiciona uma etapa à obra.
POST {{hostname}}/obras/{{obraId}}/etapas
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "etapaPadraoId": "61029696-f7bf-4c52-a183-92b3a93580e6",
    "dataInicioPrevista": "2025-08-05",
    "dataFimPrevista": "2025-08-30"
}

> {%
    client.global.set("etapaId", response.body.ID);
%}

###
# @name AlocarFuncionarioPrincipal
# 9. Aloca o funcionário principal na obra.
POST {{hostname}}/obras/{{obraId}}/alocacoes
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "funcionarioIds": ["{{funcionarioId}}"],
    "dataInicioAlocacao": "2025-08-05"
}


###
# @name ListarTodasAsObras
GET {{hostname}}/obras?page=1&pageSize=20
Cookie: jwt-token={{token}}
###

###
# @name ListarTodasAsObras
GET {{hostname}}/obras/{{obraId}}/dashboard
Cookie: jwt-token={{token}}
###

###
# @name ListarTodasAsObras
GET {{hostname}}/obras/{{obraId}}
Cookie: jwt-token={{token}}
###


# @name ListarEtapasPadrao
GET {{hostname}}/etapas-padroes
Cookie: jwt-token={{token}}
###

GET {{hostname}}/obras/{{obraId}}/etapas
Content-Type: application/json
Cookie: jwt-token={{token}}

# ===================================================================
# CRONOGRAMA DE RECEBIMENTOS
# ===================================================================

###
# @name CriarCronograma
# Cria um cronograma de recebimento individual para uma obra
POST {{hostname}}/cronograma-recebimentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "obraId": "{{obraId}}",
    "numeroEtapa": 2,
    "descricaoEtapa": "Primeira etapa - Fundação",
    "valorPrevisto": 15000.00,
    "dataVencimento": "2025-09-15T00:00:00Z"
}

> {%
    client.global.set("cronogramaId", response.body.id);
%}

###

###
# @name BuscarCronograma
# Busca um cronograma específico por ID
GET {{hostname}}/cronograma-recebimentos/{{cronogramaId}}
Cookie: jwt-token={{token}}

###
# @name RegistrarRecebimento
# Registra um recebimento parcial ou total em um cronograma
POST {{hostname}}/cronograma-recebimentos/{{cronogramaId}}/recebimentos
Content-Type: application/json
    Cookie: jwt-token={{token}}

{
    "valor": 7500.00,
    "observacoes": "Recebimento parcial da primeira etapa"
}

###
POST {{hostname}}/ccontas-receber/{{cronogramaId}}/recebimentos
Content-Type: application/json
    Cookie: jwt-token={{token}}
{
  "valor": 25000.00,
  "observacoes": "Recebimento parcial da primeira etapa"
}


###
# @name ListarCronogramasPorObra
# Lista todos os cronogramas de recebimento de uma obra específica
GET {{hostname}}/obras/{{obraId}}/cronograma-recebimentos
Cookie: jwt-token={{token}}