# ===================================================================
# TESTES COMPLETOS DO MÓDULO OBRAS
# ===================================================================
# Este arquivo contém todos os endpoints do módulo de obras para teste
# Executar em ordem para testar fluxo completo
# ===================================================================

### VARIÁVEIS GLOBAIS
@hostname = http://localhost:8084
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..htcRj9lrZQ26iYtdNFH66j7ZTwJ_NyCYcbEhE40agic
@obraId = d6d08480-cb67-4fae-8cae-d2be5808ffd4
@etapaId = bebb1ead-b773-476b-b40d-9bbfe123c9c5
@funcionarioId = fb0677ac-4c9a-49a9-b601-c0ed35f5b9fb
@funcionarioParaDeletarId =
@fornecedorId =
@materialId =
@materialId2 =
@orcamentoId = 19b50d8a-333e-4829-8731-1235e3f0e55d
@apontamentoId = c1377600-6c9d-42cd-aaba-a85b5df3d217
@etapaPadraoId = 4525251c-999c-4417-aa9e-72d7a9809b09
@cronogramaId = 57866d2e-9175-49fa-b44e-3d821560f28a
@contaReceberId = 902ef014-2c45-4270-a7c1-f7e403598834
# ===================================================================
# SEÇÃO 1: GESTÃO DE OBRAS
# ===================================================================

###
# @name CriarObraPrincipal
# Cria a obra principal para os testes
POST {{hostname}}/obras
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Nova Era 44",
    "cliente": "Incorporadora Morar Bem",
    "endereco": "Rua das Palmeiras, 100",
    "dataInicio": "2025-08-01",
    "dataFim": "2025-12-31",
    "descricao": "Obra residencial completa para teste do sistema",
    "valorContrato": 750000.00,
    "status": "Planejada"
}

> {%
    client.global.set("obraId", response.body.id);
%}

###
# @name AdicionarEtapaNaObra
# Adiciona uma etapa à obra criada
POST {{hostname}}/obras/{{obraId}}/etapas
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "etapaPadraoId": "61029696-f7bf-4c52-a183-92b3a93580e6",
    "dataInicioPrevista": "2025-08-05",
    "dataFimPrevista": "2025-08-30"
}

> {%
    client.global.set("etapaId", response.body.id);
%}

###
# @name AlocarFuncionarioNaObra
# Aloca funcionários na obra
POST {{hostname}}/obras/{{obraId}}/alocacoes
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "funcionarioIds": ["{{funcionarioId}}"],
    "dataInicioAlocacao": "2025-08-05"
}


###
# @name ListarTodasAsObras
# Lista todas as obras com paginação
GET {{hostname}}/obras?page=1&pageSize=20
Cookie: jwt-token={{token}}

###
# @name BuscarDashboardObra
# Busca dashboard com informações resumidas da obra
GET {{hostname}}/obras/{{obraId}}/dashboard
Cookie: jwt-token={{token}}

###
# @name BuscarObraPorID
# Busca uma obra específica por ID
GET {{hostname}}/obras/{{obraId}}
Cookie: jwt-token={{token}}

###
# @name AtualizarObra
# Atualiza dados de uma obra existente
PUT {{hostname}}/obras/{{obraId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Obra Atualizada - Residencial Nova Era",
    "cliente": "Incorporadora Morar Bem Atualizada",
    "endereco": "Rua das Palmeiras, 200 - Atualizado",
    "dataInicio": "2025-08-01",
    "dataFim": "2025-12-31",
    "descricao": "Obra atualizada para teste de endpoint PUT",
    "valorContrato": 850000.00,
    "status": "Em Andamento"
}

###
# @name DeletarObra
# Remove uma obra do sistema (soft delete)
DELETE {{hostname}}/obras/{{obraId}}
Cookie: jwt-token={{token}}


# ===================================================================
# SEÇÃO 2: ETAPAS DA OBRA
# ===================================================================

###
# @name ListarEtapasPorObra
# Lista todas as etapas de uma obra específica
GET {{hostname}}/obras/{{obraId}}/etapas
Content-Type: application/json
Cookie: jwt-token={{token}}

###
# @name AtualizarStatusEtapa
# Atualiza o status de uma etapa específica
PATCH {{hostname}}/etapas/{{etapaId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "status": "Completa",
    "dataInicioReal": "2025-08-06"
}

# ===================================================================
# SEÇÃO 3: ETAPAS PADRÃO (TEMPLATES)
# ===================================================================

###
# @name ListarEtapasPadrao
# Lista todas as etapas padrão disponíveis
GET {{hostname}}/etapas-padroes
Cookie: jwt-token={{token}}

###
# @name BuscarEtapaPadrao
# Busca uma etapa padrão específica por ID
GET {{hostname}}/etapas-padroes/{{etapaPadraoId}}
Cookie: jwt-token={{token}}

###
# @name CriarEtapaPadrao
# Cria uma nova etapa padrão (template)
POST {{hostname}}/etapas-padroes
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Instalações Elétricas",
    "descricao": "Execução completa das instalações elétricas",
    "duracaoEstimadaDias": 15,
    "ordem": 5
}

> {%
    client.global.set("novaEtapaPadraoId", response.body.id);
%}

###
# @name AtualizarEtapaPadrao
# Atualiza uma etapa padrão existente
PUT {{hostname}}/etapas-padroes/{{etapaPadraoId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Instalações Elétricas Atualizada",
    "descricao": "Execução completa das instalações elétricas com novos padrões",
    "duracaoEstimadaDias": 18,
    "ordem": 5
}

###
# @name DeletarEtapaPadrao
# Remove uma etapa padrão do sistema
DELETE {{hostname}}/etapas-padroes/{{etapaPadraoId}}
Cookie: jwt-token={{token}}

# ===================================================================
# SEÇÃO 4: CRONOGRAMA DE RECEBIMENTOS
# ===================================================================

###
# @name CriarCronograma
# Cria um cronograma de recebimento individual para uma obra
POST {{hostname}}/cronograma-recebimentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "obraId": "{{obraId}}",
    "numeroEtapa": 2,
    "descricaoEtapa": "Primeira etapa - Fundação",
    "valorPrevisto": 15000.00,
    "dataVencimento": "2025-09-15T00:00:00Z"
}

> {%
    client.global.set("cronogramaId", response.body.id);
%}

###
# @name CriarCronogramaEmLote
# Cria múltiplos cronogramas de recebimento para uma obra
POST {{hostname}}/cronograma-recebimentos/lote
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "obraId": "{{obraId}}",
    "cronogramas": [
        {
            "numeroEtapa": 3,
            "descricaoEtapa": "Estrutura",
            "valorPrevisto": 25000.00,
            "dataVencimento": "2025-10-15T00:00:00Z"
        },
        {
            "numeroEtapa": 4,
            "descricaoEtapa": "Acabamento",
            "valorPrevisto": 35000.00,
            "dataVencimento": "2025-11-30T00:00:00Z"
        }
    ]
}

###
# @name BuscarCronograma
# Busca um cronograma específico por ID
GET {{hostname}}/cronograma-recebimentos/{{cronogramaId}}
Cookie: jwt-token={{token}}

###
# @name RegistrarRecebimento
# Registra um recebimento parcial ou total em um cronograma
POST {{hostname}}/cronograma-recebimentos/{{cronogramaId}}/recebimentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "valor": 7500.00,
    "observacoes": "Recebimento parcial da primeira etapa"
}

###
# @name ListarCronogramasPorObra
# Lista todos os cronogramas de recebimento de uma obra específica
GET {{hostname}}/obras/{{obraId}}/cronograma-recebimentos
Cookie: jwt-token={{token}}

# ===================================================================
# SEÇÃO 5: TESTE DE SINCRONIZAÇÃO CRONOGRAMA ↔ CONTA A RECEBER
# ===================================================================

###
# @name CriarContaReceberVinculada
# Cria uma conta a receber vinculada ao cronograma para testar sincronização
POST {{hostname}}/contas-receber
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "obraId": "{{obraId}}",
    "cronogramaRecebimentoId": "{{cronogramaId}}",
    "cliente": "Incorporadora Morar Bem",
    "tipoContaReceber": "CRONOGRAMA_OBRA",
    "descricao": "Pagamento etapa - Fundação",
    "valorOriginal": 15000.00,
    "dataVencimento": "2025-09-15"
}

> {%
    client.global.set("contaReceberId", response.body.id);
%}

###
# @name RegistrarRecebimentoContaReceber
# Registra recebimento na conta a receber (deve sincronizar automaticamente com cronograma)
POST {{hostname}}/contas-receber/{{contaReceberId}}/recebimentos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "valor": 7500.00,
    "formaPagamento": "PIX",
    "observacoes": "Recebimento parcial via PIX - deve sincronizar com cronograma"
}

###
# @name VerificarCronogramaPosRecebimento
# Verifica se o cronograma foi atualizado automaticamente após recebimento
GET {{hostname}}/cronograma-recebimentos/{{cronogramaId}}
Cookie: jwt-token={{token}}

###
# @name VerificarContaReceber
# Verifica status da conta a receber
GET {{hostname}}/contas-receber/{{contaReceberId}}
Cookie: jwt-token={{token}}