@hostname = http://localhost:8084
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..gt3-sy4FUu5hB8Fx6llQi8OggK7mstAE8MkeIstwzQ4
@servicoId =5fe59444-59fd-41c8-bf7f-6de84369f706

###
# @name CriarServico
# Cria um novo serviço
POST {{hostname}}/servicos
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Instalação Elétrica Residencial"
}

###
# @name ListarServicos
# Lista todos os serviços (sem paginação)
GET {{hostname}}/servicos
Content-Type: application/json
Cookie: jwt-token={{token}}

###
# @name ListarServicosPaginado
# Lista serviços com paginação - Primeira página
GET {{hostname}}/servicos?pagina=1&tamanhoPagina=5
Content-Type: application/json
Cookie: jwt-token={{token}}

###
# @name ListarServicosPaginadoSegundaPagina
# Lista serviços com paginação - Segunda página
GET {{hostname}}/servicos?pagina=2&tamanhoPagina=5
Content-Type: application/json
Cookie: jwt-token={{token}}

###
# @name BuscarServicoPorID
# Busca um serviço por ID (substitua o valor de @servicoId)
GET {{hostname}}/servicos/{{servicoId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

###
# @name AtualizarServico
# Atualiza um serviço (substitua o valor de @servicoId)
PUT {{hostname}}/servicos/{{servicoId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

{
    "nome": "Instalação Elétrica Residencial e Comercial"
}

###
# @name DeletarServico
# Deleta um serviço (substitua o valor de @servicoId)
DELETE {{hostname}}/servicos/{{servicoId}}
Content-Type: application/json
Cookie: jwt-token={{token}}

